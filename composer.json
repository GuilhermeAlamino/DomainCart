{
    "name": "guilherme/domain-cart",
    "description": "Shopping cart domain with explicit business rules and modular sales policies.",
    "type": "project",
    "require": {
        "php": "8.2.35"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "DomainCart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DomainCart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/",
        "check:psr4": "composer dump-autoload --optimize --strict-psr",
        "check:psr12": "phpcs",
        "check:phpstan": "phpstan analyse",
        "fix:psr12": "phpcbf",
        "check": [
            "@check:psr4",
            "@check:psr12",
            "@check:phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
